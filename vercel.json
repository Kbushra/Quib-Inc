{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites":
    [
        { "source": "/api/(.*)", "destination": "/api/backend.ts" },
        { "source": "/(.*)", "has": [{ "type": "host", "value": "learning.quibinc.dpdns.org"}], "destination": "/Learning/$1" },
        { "source": "/(.*)", "destination": "/Frontend/$1" }
    ]
}